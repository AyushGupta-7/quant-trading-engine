# .env.example
# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and must NEVER be committed.
#
# -----------------------------------------------------------------------
# Zerodha Kite Connect credentials
# -----------------------------------------------------------------------
# Required for live trading via KiteBrokerAdapter and KiteFeedAdapter.
# Leave these empty (or unset) for backtesting/simulation — the engine
# will use MockBrokerAdapter and MockFeedAdapter in that case.
#
# How to obtain:
#   1. Create a Kite Connect app at https://developers.kite.trade/
#   2. Generate api_key and api_secret from your app dashboard.
#   3. Run the Kite login flow each morning to get a fresh access_token:
#
#        python scripts/kite_login.py   (see scripts/ for a helper)
#
# IMPORTANT: api_secret and access_token expire daily and are sensitive.
# Do NOT share, commit, or print them in logs.
# -----------------------------------------------------------------------

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here_used_only_during_login
KITE_ACCESS_TOKEN=your_access_token_here

# -----------------------------------------------------------------------
# Optional: override default paths
# -----------------------------------------------------------------------

# TRADING_DB_PATH=data/trading.db
# BLOTTER_PATH=data/blotter.csv
# KILL_SWITCH_FILE=data/kill_switch.lock

# -----------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------

# LOG_LEVEL=INFO
# LOG_FORMAT=json   # "json" or "console"
